# Port the API listens on.
PORT=3002

# Where the SQLite file lives. On Railway, mount a volume and point this at it
# (DATA_DIR=/data) so the database survives a redeploy.
DATA_DIR=./data

# Single shared password for the dashboard and the API. Leave it unset locally;
# set it before putting the app on a public URL.
APP_PASSWORD=

# Defaults for a newly opened month. Each month keeps its own copy of these, so
# changing them here never rewrites a month that has already been paid.
WORKING_DAYS=26
HOURS_PER_DAY=9
PT_THRESHOLD=12000
PT_AMOUNT=200

CURRENCY=INR
TIMEZONE=Asia/Kolkata

# Comma-separated origins for the dashboard when it is served separately.
# CORS_ORIGIN=https://salary.example.com

# Set to false to run the API without serving the built dashboard.
# SERVE_FRONTEND=true

# ---- punching from a phone (HRMS module 2) ----
# Off until this is true: a punch link is a door into the building.
PUNCH_ENABLED=false
# Refuse a punch with no location at all.
PUNCH_REQUIRE_LOCATION=true
# Record-and-flag a punch outside the fence rather than refusing it. Setting
# this false leaves somebody at a client's office with no attendance at all.
PUNCH_ALLOW_OUTSIDE=true
PUNCH_FENCE_METRES=200

# ---- hiring: the candidate test (HRMS module 5) ----
# The app-wide fallback test. An opening with its own `test_url` wins over
# this; blank here AND on the opening means the test step is not offered.
#
# Dinesh's own system lives in the CRM, and `t` names WHICH test:
#
#   https://crm.zyntajobs.in/test?t=office-admin
#   https://crm.zyntajobs.in/test?t=accounts        (etc.)
#
# So there is deliberately no app-wide default here - a travel consultant and
# an accounts executive do not sit the same test. Put the right link, with its
# own `t`, on each opening under Hiring -> Openings. Set this only if you have
# one general test that every opening should fall back to.
#
# (The ZYNTA website embeds `https://test.zyntajobs.in/?embed=1` under
# /skills-test. Confirm whether that is the same app before relying on it.)
TEST_EMBED_URL=
# What counts as a pass when neither the opening nor the test system says.
TEST_PASS_PERCENT=50
# How long a candidate gets for ONE question. Dinesh's figure is 30 seconds,
# which is the default — an opening's own `test_seconds_per_question` wins
# over this, and 0 turns the limit off everywhere. 0 means NO limit, never a
# limit of nought, which would fail everybody on every question. The clock
# runs inside the test system; this is only where the rule is decided.
TEST_SECONDS_PER_QUESTION=30
