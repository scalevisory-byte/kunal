# ---- How tasks get captured ----
# ai     - Claude reads every incoming chat and decides what is a task. Costs money
#          per message read, and other people's messages are sent to the API.
# manual - no AI, no API key, no cost. Only messages YOU write or forward to your
#          own chat become tasks; nobody else's messages are read or even stored.
EXTRACTION_MODE=ai
# Prefix that turns a message you send in ANY chat into a task. Blank disables it.
TASK_TRIGGER=#task

# ---- Claude (only used when EXTRACTION_MODE=ai) ----
ANTHROPIC_API_KEY=sk-ant-...
# Model used to extract tasks from batched WhatsApp messages.
# claude-haiku-4-5 is the cheapest; claude-sonnet-5 is cheaper AND newer than 4.6.
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---- Server ----
PORT=3001
# Comma-separated origins allowed to call the API. Leave unset to allow all (local dev only).
CORS_ORIGIN=http://localhost:5173
# Serve the built frontend from backend/public (set by the Docker build). Optional.
SERVE_FRONTEND=true

# ---- Storage ----
# Directory for the SQLite DB and the WhatsApp session. MUST be a persistent
# volume in production, or you re-scan the QR code on every restart.
DATA_DIR=./data

# ---- Auth ----
# When set, every /api request needs `Authorization: Bearer <this>` (the dashboard
# prompts for it once and stores it). Leave EMPTY only for local single-user use.
DASHBOARD_PASSWORD=

# ---- WhatsApp ----
# Number that receives the reminder digests, international format, no + or spaces.
# Leave empty to send to the linked account's own "message yourself" chat.
REMINDER_TO=
# IANA timezone used for due dates and the reminder cron.
TIMEZONE=Asia/Kolkata
# Reminder times (cron, in TIMEZONE). Defaults: 8:30 AM and 6:00 PM.
REMINDER_CRON_MORNING=30 8 * * *
REMINDER_CRON_EVENING=0 18 * * *
# Seconds of quiet before a batch of buffered messages is sent to Claude.
BATCH_QUIET_SECONDS=15
# Path to a Chromium binary. Required in Docker; leave unset locally to use the bundled one.
PUPPETEER_EXECUTABLE_PATH=

# ---- Web push (PWA notifications). Generate with: npx web-push generate-vapid-keys ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
