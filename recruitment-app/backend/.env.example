# Copy to backend/.env for local work. On Railway these are service variables.

# Where the SQLite file and the CVs live. On Railway, mount a volume here.
DATA_DIR=./data

# The recruiter side's one shared password. UNSET MEANS OPEN - and this app has
# a public URL by design, so set it.
APP_PASSWORD=

# Signs CV download links and apply-upload tokens. Any long random string.
# Unset means a new one per boot, which breaks links on every restart.
LINK_SECRET=

# Where the apply page is reachable, for the links that get shared.
PUBLIC_URL=https://jobs.example.com

# Dinesh's own test system, dropped into an iframe after somebody applies.
# Blank means the test step is simply not offered.
TEST_EMBED_URL=
TEST_PASS_PERCENT=50

# The agency's own WhatsApp number, for the "send today's list to myself" link.
AGENCY_WHATSAPP=
BRAND_NAME=ZYNTA Placement Services

# The commercials. Candidates are never charged any of this.
FEE_PERCENT=8.33
FEE_BASIS=annual
GST_PERCENT=18
REPLACEMENT_DAYS=90

MAX_RESUME_MB=5
RESUME_LINK_MINUTES=10
PORT=3003
